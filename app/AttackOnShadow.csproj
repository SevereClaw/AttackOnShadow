<Project Sdk="Microsoft.NET.Sdk">
  <!-- .NET Framework 4.8 ships with Windows 10/11, so the exe needs no runtime install. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>AttackOnShadow</AssemblyName>
    <RootNamespace>AttackOnShadow</RootNamespace>
    <ApplicationIcon>Assets\aos.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Version>0.0.0</Version>
    <Product>AttackOnShadow</Product>
    <Description>AttackOnShadow — приложение для клавиатуры Attack Shark K85</Description>
    <Copyright>SevereClaw</Copyright>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.IO.Compression" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\butterfly.png" />
    <Resource Include="Assets\aos.ico" />
  </ItemGroup>
</Project>
