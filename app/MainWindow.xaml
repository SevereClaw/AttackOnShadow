<Window x:Class="AttackOnShadow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AttackOnShadow.Ui"
        Title="AttackOnShadow" Width="1180" Height="720" MinWidth="1000" MinHeight="640"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Navy0}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal" Icon="pack://application:,,,/Assets/aos.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root" ClipToBounds="True" TextElement.Foreground="{StaticResource Ice}" TextElement.FontFamily="{StaticResource P3Font}">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0.1,0" EndPoint="0.6,1">
                <GradientStop Color="#0B2D7D" Offset="0"/>
                <GradientStop Color="#061A4D" Offset="0.45"/>
                <GradientStop Color="#020A26" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- background: diagonal light streaks, ripples, big faint butterfly -->
        <Canvas IsHitTestVisible="False">
            <Polygon Points="700,0 900,0 520,2000 320,2000" Fill="#127CC8FF"/>
            <Polygon Points="930,0 950,0 570,2000 550,2000" Fill="#2229D3FF"/>
            <Ellipse Canvas.Left="760" Canvas.Top="-260" Width="760" Height="760" Stroke="#0DFFFFFF" StrokeThickness="1"/>
            <Ellipse Canvas.Left="830" Canvas.Top="-190" Width="620" Height="620" Stroke="#0DFFFFFF" StrokeThickness="1"/>
            <Ellipse Canvas.Left="900" Canvas.Top="-120" Width="480" Height="480" Stroke="#0DFFFFFF" StrokeThickness="1"/>
            <Ellipse Canvas.Left="970" Canvas.Top="-50" Width="340" Height="340" Stroke="#10FFFFFF" StrokeThickness="1"/>
        </Canvas>
        <Image Source="pack://application:,,,/Assets/butterfly.png" Width="520" Opacity="0.06" HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Margin="0,0,-110,-120" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform><RotateTransform Angle="-12"/></Image.RenderTransform>
        </Image>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== left: logo, menu, device ===== -->
            <Grid Grid.Column="0" Margin="38,26,0,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/butterfly.png" Width="52" Height="52" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="AttackOnShadow" FontSize="27" FontWeight="Bold" FontStyle="Italic" Foreground="White"/>
                        <TextBlock x:Name="VersionText" Text="v0.0.0" FontSize="13" FontStyle="Italic" Foreground="{StaticResource Muted}" Margin="2,-2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="-8,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <RadioButton x:Name="NavLayers" Style="{StaticResource NavItem}" Content="СЛОИ" IsChecked="True" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavKeys" Style="{StaticResource NavItem}" Content="КЛАВИШИ" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavLight" Style="{StaticResource NavItem}" Content="ПОДСВЕТКА" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavPics" Style="{StaticResource NavItem}" Content="КАРТИНКИ" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavAuto" Style="{StaticResource NavItem}" Content="АВТОПРОФИЛИ" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Content="НАСТРОЙКИ" Checked="Nav_Checked"/>
                </StackPanel>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,12,18,14" Margin="0,0,26,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DeviceDot" Width="9" Height="9" Fill="{StaticResource Danger}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="DeviceName" Text="Attack Shark K85" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                        <TextBlock x:Name="DeviceStatus" Text="Ищу клавиатуру…" Style="{StaticResource Hint}" Margin="17,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== right: pages ===== -->
            <Grid Grid.Column="1" Margin="10,70,44,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,20">
                    <TextBlock x:Name="PageTitle" Style="{StaticResource H1}" Text="СЛОИ"/>
                    <Rectangle Height="2" Fill="{StaticResource Cyan}" HorizontalAlignment="Left" Width="120" Margin="2,2,0,0"/>
                </StackPanel>

                <!-- Layers -->
                <Grid x:Name="PageLayers" Grid.Row="1">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,26" MaxWidth="640" HorizontalAlignment="Left"
                                   Text="Слой переключается прямо в клавиатуре и остаётся выбранным, даже когда программа закрыта. Настройки клавиш и подсветки у каждого слоя свои."/>
                        <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
                            <RadioButton x:Name="Layer1" Style="{StaticResource LayerCard}" Content="1" GroupName="layer" Click="Layer_Click" Tag="0"/>
                            <RadioButton x:Name="Layer2" Style="{StaticResource LayerCard}" Content="2" GroupName="layer" Click="Layer_Click" Tag="1"/>
                        </StackPanel>
                        <TextBlock x:Name="LayersAutoNote" Style="{StaticResource Hint}" Margin="0,34,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Keys: travel, Rapid Trigger, polling rate, debounce, calibration -->
                <ScrollViewer x:Name="PageKeys" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,6,0">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,18" Padding="18,14,18,16">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Style="{StaticResource Plate}" Content="Все" Click="KeysAll_Click"/>
                                        <Button Style="{StaticResource Plate}" Content="WASD" Click="KeysWasd_Click"/>
                                        <Button Style="{StaticResource Plate}" Content="Снять" Click="KeysNone_Click" Margin="0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="KeysHint" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,14,0"
                                               Text="Щелчок — одна клавиша, Ctrl или протяжка — несколько. На клавишах — точка срабатывания в мм."/>
                                </DockPanel>
                                <Viewbox Stretch="Uniform" Margin="0,12,0,0" MaxHeight="230" HorizontalAlignment="Left">
                                    <Canvas x:Name="KeyCanvas" Background="Transparent"
                                            MouseLeftButtonDown="KeyCanvas_Down" MouseMove="KeyCanvas_Move" MouseLeftButtonUp="KeyCanvas_Up"/>
                                </Viewbox>
                            </StackPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="300"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="TravelCard" Style="{StaticResource Card}" Margin="0,0,22,0">
                                <StackPanel>
                                    <TextBlock x:Name="TravelTitle" Style="{StaticResource H2}" Text="Ход клавиш"/>
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock x:Name="ActValue" DockPanel.Dock="Right" FontSize="17" FontWeight="SemiBold" FontStyle="Italic" Foreground="{StaticResource Cyan}" Text="—"/>
                                    <TextBlock Text="Точка срабатывания" FontSize="15.5" Foreground="White"/>
                                </DockPanel>
                                <Slider x:Name="ActSlider" Minimum="0.1" Maximum="4" TickFrequency="0.1" ValueChanged="TravelSlider_Changed"/>
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock x:Name="RelValue" DockPanel.Dock="Right" FontSize="17" FontWeight="SemiBold" FontStyle="Italic" Foreground="{StaticResource Cyan}" Text="—"/>
                                    <TextBlock Text="Точка отпускания" FontSize="15.5" Foreground="White"/>
                                </DockPanel>
                                <Slider x:Name="RelSlider" Minimum="0.1" Maximum="4" TickFrequency="0.1" ValueChanged="TravelSlider_Changed"/>
                                <CheckBox x:Name="RapidBox" Content="Rapid Trigger" Margin="0,14,0,0" Checked="Travel_Changed" Unchecked="Travel_Changed"/>
                                <StackPanel x:Name="RapidPanel">
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,-4,0,2" Text="Клавиша срабатывает и отпускается по движению вверх-вниз, а не по фиксированной точке."/>
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock x:Name="RtPressValue" DockPanel.Dock="Right" FontSize="17" FontWeight="SemiBold" FontStyle="Italic" Foreground="{StaticResource Cyan}" Text="—"/>
                                    <TextBlock Text="Сработать после нажатия на" FontSize="15.5" Foreground="White"/>
                                </DockPanel>
                                <Slider x:Name="RtPressSlider" Minimum="0.2" Maximum="2.5" TickFrequency="0.1" ValueChanged="TravelSlider_Changed"/>
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock x:Name="RtReleaseValue" DockPanel.Dock="Right" FontSize="17" FontWeight="SemiBold" FontStyle="Italic" Foreground="{StaticResource Cyan}" Text="—"/>
                                    <TextBlock Text="Отпустить после подъёма на" FontSize="15.5" Foreground="White"/>
                                </DockPanel>
                                <Slider x:Name="RtReleaseSlider" Minimum="0.2" Maximum="2.5" TickFrequency="0.1" ValueChanged="TravelSlider_Changed"/>
                                </StackPanel>
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock x:Name="DeadValue" DockPanel.Dock="Right" FontSize="17" FontWeight="SemiBold" FontStyle="Italic" Foreground="{StaticResource Cyan}" Text="—"/>
                                    <TextBlock Text="Нижняя мёртвая зона (от верха)" FontSize="15.5" Foreground="White"/>
                                </DockPanel>
                                <Slider x:Name="DeadSlider" Minimum="0" Maximum="4" TickFrequency="0.1" ValueChanged="TravelSlider_Changed"/>
                                <TextBlock x:Name="TravelStatus" Style="{StaticResource Hint}" Margin="0,12,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="TravelApply" Style="{StaticResource Plate}" Content="Сохранить в клавиатуру" Click="TravelApply_Click"/>
                                    <Button x:Name="TravelRevert" Style="{StaticResource Plate}" Content="Отменить" Click="TravelRevert_Click"/>
                                </StackPanel>
                            </StackPanel>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock x:Name="RateTitle" Style="{StaticResource H2}" Text="Частота опроса"/>
                                        <WrapPanel x:Name="RatePanel"/>
                                        <DockPanel Margin="0,14,0,0">
                                            <TextBlock x:Name="DebounceValue" DockPanel.Dock="Right" FontSize="17" FontWeight="SemiBold" FontStyle="Italic" Foreground="{StaticResource Cyan}" Text="—"/>
                                            <TextBlock Style="{StaticResource H2}" Text="Антидребезг" Margin="0"/>
                                        </DockPanel>
                                        <Slider x:Name="DebounceSlider" Minimum="0" Maximum="10" ValueChanged="Debounce_Changed" PreviewMouseLeftButtonUp="Debounce_Commit" KeyUp="Debounce_KeyUp"/>
                                        <TextBlock x:Name="PerfStatus" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}" Text="Калибровка"/>
                                        <TextBlock x:Name="CalText" Style="{StaticResource Hint}" Margin="0,0,0,12"
                                                   Text="Нужна после замены свичей, обновления прошивки или если клавиши срабатывают странно."/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="CalButton" Style="{StaticResource Plate}" Content="Начать" Click="Calibrate_Click"/>
                                            <Button x:Name="CalCancel" Style="{StaticResource Plate}" Content="Прервать" Click="CalibrateCancel_Click" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Lighting -->
                <Grid x:Name="PageLight" Grid.Row="1" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="330"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Margin="0,0,22,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Style="{StaticResource H2}" Text="Эффект"/>
                                <WrapPanel x:Name="EffectsPanel"/>
                                <TextBlock x:Name="VariantTitle" Style="{StaticResource H2}" Text="Вариант" Margin="0,12,0,10"/>
                                <WrapPanel x:Name="VariantsPanel"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="Яркость"/>
                            <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="4" ValueChanged="Slider_Changed"/>
                            <TextBlock Style="{StaticResource H2}" Text="Скорость" Margin="0,16,0,10"/>
                            <Slider x:Name="SpeedSlider" Minimum="0" Maximum="4" ValueChanged="Slider_Changed"/>
                            <TextBlock Style="{StaticResource H2}" Text="Цвет" Margin="0,18,0,10"/>
                            <CheckBox x:Name="RainbowBox" Content="Радужный" Checked="Light_Changed" Unchecked="Light_Changed"/>
                            <WrapPanel x:Name="SwatchPanel" Margin="0,2,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="ColorPreview" Width="34" Height="30" Background="#29D3FF" Margin="0,0,10,0" BorderBrush="White" BorderThickness="1"/>
                                <TextBox x:Name="HexBox" Width="110" Text="#29D3FF" LostKeyboardFocus="Hex_Commit" KeyDown="Hex_KeyDown"/>
                            </StackPanel>
                            <TextBlock x:Name="LightStatus" Style="{StaticResource Hint}" Margin="0,16,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Pictures: custom picture slots and the experimental GIF-on-press mode -->
                <ScrollViewer x:Name="PagePics" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,6,0">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="250"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,20,0">
                                    <TextBlock Style="{StaticResource H2}" Text="Картинка на клавишах"/>
                                    <ui:KeyboardView x:Name="PicPreview" MaxHeight="190" HorizontalAlignment="Left"/>
                                    <DockPanel x:Name="PicFramePanel" Margin="0,10,0,0" Visibility="Collapsed">
                                        <TextBlock x:Name="PicFrameText" DockPanel.Dock="Right" FontSize="15" Foreground="{StaticResource Cyan}" Margin="12,4,0,0" Width="70"/>
                                        <Slider x:Name="PicFrameSlider" Minimum="0" Maximum="1" ValueChanged="PicFrame_Changed"/>
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,12"
                                               Text="PNG, JPG или кадр из GIF. Картинка растягивается на всю клавиатуру и хранится в самой K85 — работает и без программы."/>
                                    <Button Style="{StaticResource Plate}" Content="Выбрать файл…" HorizontalAlignment="Left" Click="PicOpen_Click"/>
                                    <TextBlock x:Name="PicFileText" Style="{StaticResource Hint}" Margin="0,8,0,14" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    <TextBlock Text="Слот" FontSize="15.5" Foreground="White" Margin="0,0,0,6"/>
                                    <WrapPanel x:Name="PicSlots"/>
                                    <Button x:Name="PicWrite" Style="{StaticResource Plate}" Content="Записать и показать" HorizontalAlignment="Left" Margin="0,6,0,0" Click="PicWrite_Click"/>
                                    <TextBlock x:Name="PicStatus" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}" BorderBrush="{StaticResource Danger}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="250"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,20,0">
                                    <TextBlock Style="{StaticResource H2}" Text="GIF при нажатии · эксперимент"/>
                                    <ui:KeyboardView x:Name="GifPreview" MaxHeight="190" HorizontalAlignment="Left"/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                               Text="Щёлкни клавишу на схеме, чтобы дать ей свою GIF. Точка — у клавиши своя GIF, у остальных — анимация по умолчанию."/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,10"
                                               Text="У K85 нет команды «показать кадр», поэтому каждый кадр записывается в слот 5 своей картинки — до 8 раз в секунду, пока идёт анимация. Как это скажется на памяти клавиатуры, неизвестно. Если K85 перестанет отвечать дважды, режим выключится сам."/>
                                    <CheckBox x:Name="GifEnabledBox" Content="Включить" Checked="GifEnabled_Changed" Unchecked="GifEnabled_Changed"/>
                                    <TextBlock x:Name="GifStatus" Style="{StaticResource Hint}" Margin="0,0,0,12"/>
                                    <TextBlock x:Name="GifKeyTitle" Text="По умолчанию" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock x:Name="GifKeyFile" Style="{StaticResource Hint}" Margin="0,2,0,8" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    <WrapPanel>
                                        <Button Style="{StaticResource Plate}" Content="GIF…" Click="GifAssign_Click" Margin="0,0,10,8"/>
                                        <Button x:Name="GifClear" Style="{StaticResource Plate}" Content="Сбросить" Click="GifClear_Click" Margin="0,0,10,8"/>
                                        <Button Style="{StaticResource Plate}" Content="Показать" Click="GifShow_Click" Margin="0,0,0,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Auto profiles -->
                <Grid x:Name="PageAuto" Grid.Row="1" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="330"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Margin="0,0,22,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <CheckBox x:Name="AutoEnabledBox" Content="Автопереключение слоёв" Checked="AutoEnabled_Changed" Unchecked="AutoEnabled_Changed"/>
                                <TextBlock x:Name="AutoStatus" Style="{StaticResource Hint}" Margin="0,0,0,14"/>
                                <TextBlock Style="{StaticResource H2}" Text="Игры"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                                <TextBlock Style="{StaticResource H2}" Text="Когда игра закрыта"/>
                                <WrapPanel>
                                    <RadioButton x:Name="FallbackNone" Style="{StaticResource Chip}" Content="Не трогать" GroupName="fb" Tag="-1" Checked="Fallback_Checked"/>
                                    <RadioButton x:Name="Fallback1" Style="{StaticResource Chip}" Content="Слой 1" GroupName="fb" Tag="0" Checked="Fallback_Checked"/>
                                    <RadioButton x:Name="Fallback2" Style="{StaticResource Chip}" Content="Слой 2" GroupName="fb" Tag="1" Checked="Fallback_Checked"/>
                                </WrapPanel>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="RulesPanel"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Style="{StaticResource H2}" Text="Добавить игру"/>
                                <TextBox x:Name="ExeBox" Margin="0,0,0,8"/>
                                <TextBlock Style="{StaticResource Hint}" Text="Впиши имя .exe или выбери из запущенных:" Margin="0,0,0,6"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                <WrapPanel Margin="0,0,0,6">
                                    <RadioButton x:Name="NewRule1" Style="{StaticResource Chip}" Content="Слой 1" GroupName="nr" IsChecked="True"/>
                                    <RadioButton x:Name="NewRule2" Style="{StaticResource Chip}" Content="Слой 2" GroupName="nr"/>
                                </WrapPanel>
                                <Button Style="{StaticResource Plate}" Content="Добавить" HorizontalAlignment="Left" Click="AddRule_Click"/>
                            </StackPanel>
                            <ListBox x:Name="ProcessList" SelectionChanged="ProcessList_SelectionChanged"/>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- Settings -->
                <ScrollViewer x:Name="PageSettings" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Программа"/>
                                <CheckBox x:Name="AutostartBox" Content="Запускать вместе с Windows (сразу в трей)" Checked="Settings_Changed" Unchecked="Settings_Changed"/>
                                <CheckBox x:Name="TrayBox" Content="Крестик сворачивает в трей, а не закрывает" Checked="Settings_Changed" Unchecked="Settings_Changed"/>
                                <CheckBox x:Name="UsbLogBox" Content="Вести журнал обмена с клавиатурой (для отладки)" Checked="Settings_Changed" Unchecked="Settings_Changed"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Style="{StaticResource Plate}" Content="Папка с журналами" Click="OpenLogs_Click"/>
                                    <Button x:Name="InstallButton" Style="{StaticResource Plate}" Content="Установить в систему" Click="Install_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Обновления"/>
                                <CheckBox x:Name="UpdatesBox" Content="Проверять раз в день" Checked="Settings_Changed" Unchecked="Settings_Changed"/>
                                <CheckBox x:Name="AutoUpdateBox" Content="Ставить сами, когда программа в трее и игра не запущена" Checked="Settings_Changed" Unchecked="Settings_Changed"/>
                                <TextBlock x:Name="UpdateStatus" Style="{StaticResource Hint}" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource Plate}" Content="Проверить" Click="CheckUpdate_Click"/>
                                    <Button x:Name="UpdateButton" Style="{StaticResource Plate}" Content="Обновить" Click="Update_Click" Visibility="Collapsed"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border x:Name="ConflictCard" Style="{StaticResource Card}" Margin="0,0,0,18" Visibility="Collapsed" BorderBrush="{StaticResource Danger}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Attack Shark Driver"/>
                                <TextBlock x:Name="ConflictText" Style="{StaticResource Hint}" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="RemoveModButton" Style="{StaticResource Plate}" Content="Удалить старый мод" Click="RemoveMod_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- caption buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource Caption}" Content="—" Click="Minimize_Click"/>
            <Button Style="{StaticResource Caption}" Content="✕" Click="Close_Click"/>
        </StackPanel>

        <!-- toast -->
        <Grid x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,40" Opacity="0" IsHitTestVisible="False">
            <Border Background="{StaticResource Cyan}" RenderTransform="{StaticResource Skew}" Margin="6,5,-6,-5"/>
            <Border Background="White" RenderTransform="{StaticResource Skew}"/>
            <TextBlock x:Name="ToastText" Margin="30,9" FontSize="16" FontWeight="Bold" FontStyle="Italic" Foreground="{StaticResource Navy1}"/>
        </Grid>
    </Grid>
</Window>
