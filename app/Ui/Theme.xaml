<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Persona 3 Reload palette -->
    <Color x:Key="Navy0C">#020A26</Color>
    <Color x:Key="Navy1C">#061A4D</Color>
    <Color x:Key="Navy2C">#0B2D7D</Color>
    <SolidColorBrush x:Key="Navy0" Color="#020A26"/>
    <SolidColorBrush x:Key="Navy1" Color="#061A4D"/>
    <SolidColorBrush x:Key="Navy2" Color="#0B2D7D"/>
    <SolidColorBrush x:Key="Blue" Color="#1F6BFF"/>
    <SolidColorBrush x:Key="Cyan" Color="#29D3FF"/>
    <SolidColorBrush x:Key="Ice" Color="#D8ECFF"/>
    <SolidColorBrush x:Key="Muted" Color="#8FB2E6"/>
    <SolidColorBrush x:Key="Glass" Color="#8C04103A"/>
    <SolidColorBrush x:Key="GlassLine" Color="#5929D3FF"/>
    <SolidColorBrush x:Key="Danger" Color="#FF5C86"/>

    <FontFamily x:Key="P3Font">Bahnschrift SemiCondensed, Bahnschrift, Segoe UI</FontFamily>
    <SkewTransform x:Key="Skew" AngleX="-18"/>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource P3Font}"/>
        <Setter Property="Foreground" Value="{StaticResource Ice}"/>
    </Style>
    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource P3Font}"/>
        <Setter Property="FontSize" Value="46"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource P3Font}"/>
        <Setter Property="FontSize" Value="19"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource P3Font}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="19"/>
    </Style>

    <!-- Glass card with a cut corner and a cyan edge -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#9E0E2E82" Offset="0"/>
                    <GradientStop Color="#C7040E2E" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="{StaticResource Cyan}"/>
        <Setter Property="BorderThickness" Value="3,0,0,0"/>
        <Setter Property="Padding" Value="22,18,22,20"/>
    </Style>

    <!-- Big left menu item: white skewed plate when selected -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource P3Font}"/>
        <Setter Property="FontSize" Value="36"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="Foreground" Value="{StaticResource Ice}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="GroupName" Value="nav"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent" Height="58" HorizontalAlignment="Left">
                        <Border x:Name="shadow" Background="{StaticResource Cyan}" RenderTransform="{StaticResource Skew}" Margin="8,6,-8,-6" Opacity="0"/>
                        <Border x:Name="plate" Background="White" RenderTransform="{StaticResource Skew}" Opacity="0"/>
                        <ContentPresenter x:Name="text" Margin="22,0,30,0" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter TargetName="text" Property="Margin" Value="30,0,22,0"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="plate" Property="Opacity" Value="1"/>
                            <Setter TargetName="shadow" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{StaticResource Navy1}"/>
                            <Setter TargetName="text" Property="Margin" Value="22,0,30,0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small selectable chip (effects, variants, layers) -->
    <Style x:Key="Chip" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource P3Font}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="Foreground" Value="{StaticResource Ice}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,12,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent" MinHeight="34">
                        <Border x:Name="shadow" Background="{StaticResource Cyan}" RenderTransform="{StaticResource Skew}" Margin="5,4,-5,-4" Opacity="0"/>
                        <Border x:Name="plate" Background="#592452CC" BorderBrush="#7329D3FF" BorderThickness="1" RenderTransform="{StaticResource Skew}"/>
                        <ContentPresenter Margin="18,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="plate" Property="Background" Value="#802E6BFF"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="plate" Property="Background" Value="White"/>
                            <Setter TargetName="plate" Property="BorderBrush" Value="White"/>
                            <Setter TargetName="shadow" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{StaticResource Navy1}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Big layer card -->
    <Style x:Key="LayerCard" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource P3Font}"/>
        <Setter Property="Foreground" Value="{StaticResource Ice}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="270"/>
        <Setter Property="Height" Value="210"/>
        <Setter Property="Margin" Value="0,0,40,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="shadow" Background="{StaticResource Cyan}" RenderTransform="{StaticResource Skew}" Margin="12,10,-12,-10" Opacity="0"/>
                        <Border x:Name="plate" RenderTransform="{StaticResource Skew}" BorderBrush="#9929D3FF" BorderThickness="2">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#B00E2E82" Offset="0"/>
                                    <GradientStop Color="#D0040E2E" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="34,0,0,0">
                            <TextBlock x:Name="cap" Text="СЛОЙ" FontSize="24" FontStyle="Italic" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}"/>
                            <ContentPresenter x:Name="num" TextElement.FontSize="120" TextElement.FontWeight="Bold" TextElement.FontStyle="Italic" Margin="0,-24,0,-22"/>
                            <TextBlock x:Name="state" Text="" FontSize="15" FontStyle="Italic" Foreground="{TemplateBinding Foreground}" Opacity="0.85"/>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="plate" Property="BorderBrush" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="plate" Property="Background" Value="White"/>
                            <Setter TargetName="plate" Property="BorderBrush" Value="White"/>
                            <Setter TargetName="shadow" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{StaticResource Navy1}"/>
                            <Setter TargetName="state" Property="Text" Value="активен"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Skewed button -->
    <Style x:Key="Plate" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource P3Font}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="Foreground" Value="{StaticResource Ice}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,14,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" MinHeight="36">
                        <Border x:Name="shadow" Background="{StaticResource Cyan}" RenderTransform="{StaticResource Skew}" Margin="5,4,-5,-4" Opacity="0"/>
                        <Border x:Name="plate" Background="#8C1F6BFF" BorderBrush="#9929D3FF" BorderThickness="1" RenderTransform="{StaticResource Skew}"/>
                        <ContentPresenter Margin="22,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="plate" Property="Background" Value="White"/>
                            <Setter TargetName="shadow" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{StaticResource Navy1}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="shadow" Property="Opacity" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Window caption buttons -->
    <Style x:Key="Caption" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#33FFFFFF"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Checkbox: skewed box -->
    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource P3Font}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="{StaticResource Ice}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="22" Height="22" VerticalAlignment="Center">
                            <Border x:Name="box" BorderBrush="{StaticResource Cyan}" BorderThickness="2" Background="#66020A26" RenderTransform="{StaticResource Skew}" RenderTransformOrigin="0.5,0.5"/>
                            <Border x:Name="fill" Background="White" Margin="5" RenderTransform="{StaticResource Skew}" RenderTransformOrigin="0.5,0.5" Opacity="0"/>
                        </Grid>
                        <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="fill" Property="Opacity" Value="1"/>
                            <Setter TargetName="box" Property="Background" Value="{StaticResource Blue}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slider: thin track, skewed white thumb -->
    <Style x:Key="ThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="18" Height="26">
                        <Border Background="{StaticResource Cyan}" RenderTransform="{StaticResource Skew}" Margin="3,3,-3,-3"/>
                        <Border Background="White" RenderTransform="{StaticResource Skew}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Slider">
        <Setter Property="IsSnapToTickEnabled" Value="True"/>
        <Setter Property="TickFrequency" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="30">
                        <Border Height="4" Background="#593C78DC" VerticalAlignment="Center"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton"><Border Height="4" Background="{StaticResource Cyan}" VerticalAlignment="Center"/></ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb><Thumb Style="{StaticResource ThumbStyle}"/></Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource P3Font}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="CaretBrush" Value="{StaticResource Cyan}"/>
        <Setter Property="Background" Value="#CC020A26"/>
        <Setter Property="BorderBrush" Value="#598FB2E6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Cyan}"/></Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="#99020A26"/>
        <Setter Property="BorderBrush" Value="#598FB2E6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource Ice}"/>
        <Setter Property="FontFamily" Value="{StaticResource P3Font}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bg" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="#402E6BFF"/></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="{StaticResource Navy1}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slim scrollbar -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/>
        <Setter Property="MinWidth" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="#40020A26">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb"><Border Background="{StaticResource Blue}"/></ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
